package pages

import (
	"cmp"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Sighting(s sighting.Sighting) {
	{{ name := animalName(s) }}
	@layout.Base(layout.BaseProps{
		Title:       name + " · Stage report · Safari Rally Kenya",
		Description: "Stage report: " + name + " seen at " + where(s) + ".",
		Map:         true,
	}) {
		<article class="report">
			<p class="report__back"><a href={ templ.URL("/#" + components.Anchor(s)) }>← Back to the stage results</a></p>
			<header class="report__head">
				<p class="section__num">Stage report</p>
				<div>
					<h1>{ name }</h1>
					if s.Species.ScientificName != "" {
						<p class="report__scientific">{ s.Species.ScientificName }</p>
					}
					@components.StageBadge(s)
				</div>
			</header>
			<div class="report__grid">
				<div class="report__photo">
					if photo, ok := firstPhoto(s); ok {
						<figure>
							<a href={ templ.URL(photo.URL) } data-lightbox data-caption={ photoCredit(photo) }>
								<img src={ photo.URL } alt={ cmp.Or(photo.Title, name) }/>
							</a>
							<figcaption>{ photoCredit(photo) }</figcaption>
						</figure>
					} else {
						<div class="report__nophoto"><span>No photo on this stage</span></div>
					}
				</div>
				<div class="report__side">
					<dl class="board board--report">
						<div class="board__cell">
							<dt>Seen</dt>
							<dd><time datetime={ s.HappenedAt.Format("2006-01-02") }>{ s.HappenedAt.Format("2 Jan 2006") }</time></dd>
						</div>
						<div class="board__cell">
							<dt>Count</dt>
							<dd>{ countText(s) }</dd>
						</div>
					</dl>
					<dl class="report__facts">
						<div>
							<dt>Where</dt>
							<dd>{ where(s) }</dd>
						</div>
						<div>
							<dt>Crew</dt>
							<dd>{ cmp.Or(s.RecordedBy, "Not recorded") }</dd>
						</div>
						if s.BasisOfRecord != "" {
							<div>
								<dt>Recorded as</dt>
								<dd>{ basis(s.BasisOfRecord) }</dd>
							</div>
						}
						if s.Location.Latitude != 0 || s.Location.Longitude != 0 {
							<div>
								<dt>Position</dt>
								<dd>{ position(s) }</dd>
							</div>
						}
					</dl>
					<section class="report__panel" aria-labelledby="conditions-title">
						<h2 id="conditions-title" class="panel__title">Stage conditions</h2>
						@components.StageConditions(s.Weather, true)
					</section>
				</div>
			</div>
			if s.Location.Latitude != 0 || s.Location.Longitude != 0 {
				<section class="report__map" aria-labelledby="map-title">
					<h2 id="map-title" class="panel__title">Where on the route</h2>
					@components.Map(components.MapProps{
						Points:  components.SpotPoints(s),
						Stages:  components.Stages,
						ID:      "spot-points",
						MaxZoom: 10,
						Label:   "Map of where the " + name + " was seen",
						Class:   "map--dark map--small",
					})
				</section>
			}
			if more := morePhotos(s); len(more) > 0 {
				<section class="report__more" aria-labelledby="more-title">
					<h2 id="more-title" class="panel__title">More photos</h2>
					@components.Gallery(more)
				</section>
			}
			if s.Remarks != "" {
				<section class="report__notes">
					<h2 class="panel__title">Notes from the crew</h2>
					<p>{ s.Remarks }</p>
				</section>
			}
			if s.ReferenceURL != "" {
				<p class="report__source"><a href={ templ.URL(s.ReferenceURL) } rel="noopener">See the original record</a></p>
			}
		</article>
	}
}
